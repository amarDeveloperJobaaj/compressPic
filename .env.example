# ------------------------------------------------------------------
# Vizo Tool — Admin authentication (static, env-driven)
#
# Copy this file to `.env.local` and adjust the values. The admin panel
# reads these server-side only — they are never shipped to the client.
# ------------------------------------------------------------------

# Admin login username
ADMIN_USERNAME=vizoadmin

# Admin login password
ADMIN_PASSWORD=Vizotool@2026#Admin

# Secret used to HMAC-sign the admin session cookie.
# In production set a long random value, e.g. from `openssl rand -hex 32`
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Session lifetime in days (default 7)
ADMIN_SESSION_DAYS=7

# ------------------------------------------------------------------
# Vizo Tool — Supabase (blog backend)
#
# The blog system runs on the in-memory dummy store by default. To use the
# production backend: run supabase/schema.sql + supabase/storage.sql in your
# Supabase project, paste your real values into `.env.local`, then set
# BLOG_STORAGE=supabase.
#
#   SECURITY
#   - The anon key is public (it ships to the browser) — that is expected.
#   - SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security and must NEVER
#     be exposed to the client or committed to git. Keep it only in .env.local.
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://iejdsqcrwnkqtziejazo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_4XFiGXwktO6jbMC-QYtunw_uVC_yMaS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImllamRzcWNyd25rcXR6aWVqYXpvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU4MjQ1MTMsImV4cCI6MjEwMTQwMDUxM30.IxfGwRRZsEPrFQq-VYr5swQo9mYJ30vhzmL_JQBSv7k

# Server-only. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImllamRzcWNyd25rcXR6aWVqYXpvIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTgyNDUxMywiZXhwIjoyMTAxNDAwNTEzfQ.Pmk-qgNpgUqsRziEFTkKrmr6wSSEhMYQVl7Sn6Nsc98

# Blog data layer: "memory" (default, dummy store) | "supabase" (production)
BLOG_STORAGE=supabase
