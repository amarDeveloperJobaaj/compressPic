# ------------------------------------------------------------------
# Vizo Tool — Admin authentication (static, env-driven)
#
# Copy this file to `.env.local` and adjust the values. The admin panel
# reads these server-side only — they are never shipped to the client.
# ------------------------------------------------------------------

# Admin login username
ADMIN_USERNAME=vizoadmin

# Admin login password
ADMIN_PASSWORD=Vizotool@2026#Admin

# Secret used to HMAC-sign the admin session cookie.
# In production set a long random value, e.g. from `openssl rand -hex 32`
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Session lifetime in days (default 7)
ADMIN_SESSION_DAYS=7
